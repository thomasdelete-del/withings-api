# Öffentliche Railway-Adresse, ohne abschließenden Schrägstrich
BASE_URL=https://DEIN-DIENST.up.railway.app

# Railway-Volume wird nach /data eingehängt
DATABASE_PATH=/data/withings.db

# Eigener langer Zufallswert für REST-Aufrufe
API_KEY=HIER-EINEN-LANGEN-ZUFALLSWERT-EINTRAGEN

# Browser-Anmeldung für /oauth/start und /admin/status
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HIER-EIN-STARKES-PASSWORT-EINTRAGEN

# Erzeugen mit:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=HIER-FERNET-SCHLUESSEL-EINTRAGEN

# Aus dem Withings Developer Dashboard
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Muss exakt im Withings Developer Dashboard registriert sein.
# Leer lassen, um automatisch BASE_URL/oauth/callback zu verwenden.
WITHINGS_REDIRECT_URI=
WITHINGS_SCOPES=user.metrics

SYNC_INTERVAL_MINUTES=30
IMPORT_TIMEZONE=Europe/Berlin
MAX_UPLOAD_MIB=25

# Optional: nur setzen, wenn ein im Browser geöffnetes Dashboard (o.ä.) die API
# per JavaScript-fetch() direkt aufrufen soll. Leer = CORS deaktiviert (Standard).
# "*" erlaubt jede Seite (Zugriffsschutz bleibt der X-API-Key), alternativ eine
# kommagetrennte Liste exakter Origins, z.B. https://meine-seite.example
CORS_ALLOW_ORIGINS=
